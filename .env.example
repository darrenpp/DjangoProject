# Copy this file to .env and set deployment-specific values locally.
# Never commit a populated .env file or real service credentials.
DJANGO_DEBUG=False
SECRET_KEY=change-me-to-a-long-random-production-secret
ALLOWED_HOSTS=registration.health.gov.pg
CSRF_TRUSTED_ORIGINS=https://registration.health.gov.pg
LOCAL_MOBILE_TESTING=False

DATABASE_ENGINE=postgresql
DB_NAME=ndoh_registry
DB_USER=ndoh_registry_user
DB_PASSWORD=change-me-to-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

USE_HTTPS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@health.gov.pg

AI_ASSISTANT_PROVIDER=local
AI_ASSISTANT_EXTERNAL_ENABLED=False
AI_REDIS_WORKER_ENABLED=False
AI_REDIS_URL=redis://localhost:6379/0
AI_REDIS_WORKER_QUEUE=staff_ai_requests
AI_REDIS_WORKER_MODEL_PROVIDER=local
AI_REDIS_WORKER_MODEL_BASE_URL=
AI_REDIS_WORKER_MODEL_API_KEY=
AI_REDIS_WORKER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_GOOGLE_ADK_ENABLED=False
GOOGLE_API_KEY=
AI_GOOGLE_ADK_MODEL=gemini-flash-latest
AI_ASSISTANT_LOCALAI_ENABLED=False
AI_LOCALAI_BASE_URL=http://127.0.0.1:8080
AI_LOCALAI_API_KEY=
AI_LOCALAI_MODEL=
AI_ASSISTANT_OLLAMA_ENABLED=False
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=
AI_OLLAMA_KEEP_ALIVE=10m
AI_OLLAMA_NUM_PREDICT=240
AI_OLLAMA_NUM_CTX=2048
AI_ASSISTANT_LOCAL_LLM_ENABLED=False
AI_LOCAL_LLM_BASE_URL=
AI_LOCAL_LLM_API_KEY=
AI_LOCAL_LLM_MODEL=
AI_ASSISTANT_RAG_ENABLED=False
AI_ASSISTANT_RAG_AUTO_BUILD=True
AI_ASSISTANT_RAG_INDEX_PATH=
AI_ASSISTANT_RAG_VECTOR_BACKEND=local_json
AI_ASSISTANT_CHROMA_PATH=
AI_ASSISTANT_CHROMA_COLLECTION=staff_assistant_knowledge
AI_ASSISTANT_RAG_MAX_DOCUMENTS=800
AI_ASSISTANT_RAG_MIN_SCORE=0.18
AI_ASSISTANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_ASSISTANT_EMBEDDING_LOCAL_FILES_ONLY=True
REGULATORY_ML_ENABLED=True
REGULATORY_ML_USE_SCIKIT_LEARN=True
# Do not enable raw registry/chat training without an approved, redacted model-governance process.
REGULATORY_ML_ALLOW_TRAINING=False
REGULATORY_ML_CACHE_SECONDS=300
REGULATORY_ML_FORECAST_HORIZON_YEARS=10
REGULATORY_ML_MIN_TRAINING_OBSERVATIONS=8
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
