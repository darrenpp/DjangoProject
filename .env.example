DEBUG=False
SECRET_KEY=replace-with-a-strong-50-plus-character-secret-key
ALLOWED_HOSTS=registration.health.gov.pg
CSRF_TRUSTED_ORIGINS=https://registration.health.gov.pg

DATABASE_ENGINE=postgresql
DB_NAME=ndoh_registry
DB_USER=ndoh_registry_user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

USE_HTTPS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@health.gov.pg

AI_ASSISTANT_PROVIDER=local
AI_ASSISTANT_EXTERNAL_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
